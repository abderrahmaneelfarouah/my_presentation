{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/check-digicode",
      "destination": "/api/check-digicode.js"
    },
    {
      "source": "/api/appointments",
      "destination": "/api/appointments.js"
    },
    {
      "source": "/api/resend",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/test-email",
      "destination": "/api/test-email.js"
    },
    {
      "source": "/site\\.webmanifest$",
      "destination": "/site.webmanifest"
    },
    {
      "source": "/robots\\.txt$",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap\\.xml$",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/geo-sitemap\\.xml$",
      "destination": "/geo-sitemap.xml"
    },
    {
      "source": "/site-version\\.txt$",
      "destination": "/site-version.txt"
    },
    {
      "source": "/site-version\\.json$",
      "destination": "/site-version.json"
    },
    {
      "source": "/manifest\\.json$",
      "destination": "/manifest.json"
    },
    {
      "source": "/local-business\\.json$",
      "destination": "/local-business.json"
    },
    {
      "source": "/og-image\\.png$",
      "destination": "/og-image.png"
    },
    {
      "source": "/favicon\\.png$",
      "destination": "/favicon.png"
    },
    {
      "source": "/apple-touch-icon\\.png$",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
